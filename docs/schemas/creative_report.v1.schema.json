{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeReport",
  "description": "`reports/<date>/creative-report.json` - THE product artifact. The\nHTML renderer, a bot text-summarizer, and the future service's\nPostgres ingester consume exactly this; the renderer never touches\nsnapshots. Every array element carries its own natural key so rows\nupsert losslessly: (workspace_id, report_date) > product > group_key\n> targeting/date.",
  "type": "object",
  "properties": {
    "exec_brief": {
      "description": "\"Yesterday in brief\" - 3-5 deterministic one-liners (client\nspec G1-G6). Additive v1 field.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ExecLine"
      }
    },
    "generated_at": {
      "description": "RFC3339 UTC generation timestamp.",
      "type": "string"
    },
    "portfolio": {
      "description": "Portfolio KPIs - a bot renders exactly this block as the headline.",
      "$ref": "#/$defs/Kpis"
    },
    "prior_date": {
      "description": "The prior comparable report's date when deltas were computable.",
      "type": [
        "string",
        "null"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProductSection"
      }
    },
    "report_date": {
      "description": "Snapshot date the report was computed FROM (YYYY-MM-DD).",
      "type": "string"
    },
    "schema": {
      "description": "`moneyball.creative_report/<major>`.",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ReportSource"
    },
    "window": {
      "$ref": "#/$defs/ReportWindow"
    },
    "workspace_id": {
      "description": "Stable workspace UUID (minted once into config.json). With\nreport_date + schema major: the idempotent-upsert key.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "workspace_id",
    "report_date",
    "window",
    "generated_at",
    "source",
    "portfolio",
    "products"
  ],
  "$defs": {
    "CardStatus": {
      "description": "live | learn | stop with a display label (learning-stage detail is\na v2 additive field).",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/StatusCode"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "label"
      ]
    },
    "CreativeCard": {
      "description": "One creative (a group of ads sharing an image/video), the report's\nunit of comparison.",
      "type": "object",
      "properties": {
        "ad_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "campaigns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created": {
          "description": "Earliest creative created date in the group (YYYY-MM-DD).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "display_name": {
          "description": "Most-common ad_name in the group.",
          "type": "string"
        },
        "funnel": {
          "description": "The seven canonical stages, ordered, ALWAYS all present -\nrenderers iterate this array, never reconstruct it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FunnelStage"
          }
        },
        "group_key": {
          "description": "Grouping key with its kind prefixed, e.g. `img:<image_hash>`,\n`vid:<video_id>`, `family:<slug>`, `ad:<ad_id>`. PK within\n(workspace, report_date, product).",
          "type": "string"
        },
        "group_kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "image": {
          "description": "None => renderers show a placeholder.",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_video": {
          "type": "boolean"
        },
        "segmentation": {
          "description": "The M-Leads -> L-Leads gap explained (None when leads.json is\nabsent from the snapshot). Additive v1 field.",
          "anyOf": [
            {
              "$ref": "#/$defs/Segmentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/CardStatus"
        },
        "targetings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TargetingBreakdown"
          }
        },
        "trend": {
          "description": "Daily buckets across the trailing window, oldest first.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrendBucket"
          }
        }
      },
      "required": [
        "group_key",
        "group_kind",
        "display_name",
        "ad_ids",
        "campaigns",
        "is_video",
        "status",
        "delivery",
        "funnel"
      ]
    },
    "Delivery": {
      "description": "Meta delivery metrics for a card or targeting row.",
      "type": "object",
      "properties": {
        "clicks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "impressions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "m_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reach": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "spend": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "spend",
        "impressions",
        "clicks",
        "m_leads"
      ]
    },
    "ExecLine": {
      "description": "One executive-brief line. `tone` drives the marker color only.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "tone": {
          "description": "win | watch | info",
          "type": "string"
        }
      },
      "required": [
        "tone",
        "text"
      ]
    },
    "FunnelCounts": {
      "description": "CRM-joined funnel counts (Meta m_leads + the four CRM milestones).",
      "type": "object",
      "properties": {
        "booking": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "l_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "m_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "visit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "m_leads",
        "l_leads",
        "qualified",
        "visit",
        "booking"
      ]
    },
    "FunnelStage": {
      "description": "One step of the canonical funnel. Stage names are fixed:\nImpressions, Clicks, M-Leads, L-Leads, Qualified, Visit, Booking.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "count"
      ]
    },
    "GroupKind": {
      "description": "How the group was identified (precedence: family > video_name >\nvideo_id > image_hash > image_basename > ad_id).",
      "type": "string",
      "enum": [
        "family",
        "video_name",
        "video_id",
        "image_hash",
        "image_basename",
        "ad_id"
      ]
    },
    "ImageRef": {
      "description": "Pointer into the content-addressed asset cache; `path` is relative\nto `<workspace>/.moneyball/history/`.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "path"
      ]
    },
    "Kpis": {
      "description": "Delivery + funnel roll-up. Numbers are NUMBERS here - Meta's\nstring-typing is a snapshot-layer quirk, the aggregate is typed.",
      "type": "object",
      "properties": {
        "clicks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_per_qualified": {
          "description": "None when qualified == 0 - never 0-as-sentinel.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "funnel": {
          "$ref": "#/$defs/FunnelCounts"
        },
        "impressions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "l_to_q_pct": {
          "description": "None when l_leads == 0.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "spend": {
          "type": "number",
          "format": "double"
        },
        "unattributed_l_leads": {
          "description": "CRM tickets with no joinable ad_id (includes the intentional\n\"Stattic Ad\" rows) - counted, never silently dropped.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "spend",
        "impressions",
        "clicks",
        "funnel"
      ]
    },
    "ProductSection": {
      "type": "object",
      "properties": {
        "creatives": {
          "description": "Sorted python-style: booking desc, then visit, qualified,\nl_leads, m_leads.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CreativeCard"
          }
        },
        "cross_reads": {
          "description": "Deterministic cross-creative/targeting reads; empty when no\nread passes its minimum-data gates (never filler).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "kpis": {
          "$ref": "#/$defs/Kpis"
        },
        "product": {
          "type": "string"
        },
        "targetings": {
          "description": "Per-targeting roll-up across the product's creatives, spend\ndesc. Additive v1 field (empty for pre-v2 consumers).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TargetingReport"
          }
        }
      },
      "required": [
        "product",
        "kpis",
        "creatives"
      ]
    },
    "ReportSource": {
      "description": "Provenance for audit / re-derivation.",
      "type": "object",
      "properties": {
        "creatives_schema": {
          "description": "Schema string of the creatives.json consumed; None when the\nsnapshot predates creatives capture (cards fall back to\none-ad-per-card grouping).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "crm_present": {
          "type": "boolean"
        },
        "snapshot_date": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_date",
        "crm_present"
      ]
    },
    "ReportWindow": {
      "description": "Days of data the report aggregates (inclusive, YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      },
      "required": [
        "since",
        "until"
      ]
    },
    "Segmentation": {
      "description": "Window Meta leads split by fate (python SEG_KEYS):\ncaptured + reinquiry + duplicate + invalid + uncaptured == total.",
      "type": "object",
      "properties": {
        "captured": {
          "description": "Became an L-Lead (lead_id present in CRM tickets).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "duplicate": {
          "description": "Same contact submitted again (CRM folds it).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "invalid": {
          "description": "Phone not a valid mobile - CRM rejects.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reinquiry": {
          "description": "Contact already exists in the CRM under another campaign.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "uncaptured": {
          "description": "Valid, unique, new - but not in the CRM: a genuine sync gap.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "captured",
        "reinquiry",
        "duplicate",
        "invalid",
        "uncaptured"
      ]
    },
    "SevenDay": {
      "type": "object",
      "properties": {
        "clicks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "impressions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "l_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "m_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "spend": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "spend",
        "impressions",
        "clicks",
        "m_leads",
        "l_leads",
        "qualified"
      ]
    },
    "StatusCode": {
      "type": "string",
      "enum": [
        "live",
        "learn",
        "stop"
      ]
    },
    "TargetingBreakdown": {
      "description": "Per-targeting (= base adset name, campaign suffix stripped) split.",
      "type": "object",
      "properties": {
        "crm": {
          "$ref": "#/$defs/TargetingCrm"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "targeting": {
          "type": "string"
        }
      },
      "required": [
        "targeting",
        "delivery",
        "crm"
      ]
    },
    "TargetingCrm": {
      "type": "object",
      "properties": {
        "booking": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "l_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "visit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "l_leads",
        "qualified",
        "visit",
        "booking"
      ]
    },
    "TargetingReport": {
      "description": "One targeting (base adset name) aggregated across creatives.\nThe window columns show the report day; VERDICTS are computed on\nthe trailing-7d aggregate - one day of lead-gen is 0-3 qualified\nand statistically dishonest to verdict on (marketing spec\n2026-08-10).",
      "type": "object",
      "properties": {
        "archetype": {
          "description": "Pincode / Lookalike / Detailed / Broad-Income / Other\n(python _archetype).",
          "type": "string",
          "default": ""
        },
        "recent_l_72h": {
          "description": "L-leads delivered in the trailing 72h - the maturation guard:\nnever verdict kill while leads are still being worked.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "specs": {
          "description": "From the adset spec, when adsets.json was captured.",
          "anyOf": [
            {
              "$ref": "#/$defs/TargetingSpecs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targeting": {
          "type": "string"
        },
        "verdicts": {
          "description": "Deterministic verdict chips, at most 2, precedence-ordered.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Verdict"
          }
        },
        "window": {
          "description": "Report-window delivery + CRM counts.",
          "$ref": "#/$defs/Delivery"
        },
        "window_7d": {
          "description": "Trailing 7 complete days (verdict basis).",
          "$ref": "#/$defs/SevenDay",
          "default": {
            "clicks": 0,
            "impressions": 0,
            "l_leads": 0,
            "m_leads": 0,
            "qualified": 0,
            "spend": 0.0
          }
        },
        "window_crm": {
          "$ref": "#/$defs/TargetingCrm",
          "default": {
            "booking": 0,
            "l_leads": 0,
            "qualified": 0,
            "visit": 0
          }
        }
      },
      "required": [
        "targeting",
        "window"
      ]
    },
    "TargetingSpecs": {
      "type": "object",
      "properties": {
        "age": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "genders": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "geo": {
          "description": "Short geo summary, e.g. \"Bengaluru +2 more\" or \"IN\".",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "learning": {
          "description": "LEARNING / SUCCESS / FAIL, verbatim from Meta.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "optimization_goal": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "TrendBucket": {
      "description": "One day of a card's trend series.",
      "type": "object",
      "properties": {
        "booking": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "clicks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "date": {
          "description": "YYYY-MM-DD.",
          "type": "string"
        },
        "impressions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "l_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "m_leads": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "qualified": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "visit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "date",
        "impressions",
        "clicks",
        "m_leads",
        "l_leads",
        "qualified",
        "visit",
        "booking"
      ]
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "code": {
          "description": "scale | kill | zero_crm | learning | quality_leak | wait",
          "type": "string"
        },
        "detail": {
          "description": "One-line justification with the numbers.",
          "type": "string"
        },
        "label": {
          "description": "Chip label, e.g. \"Kill\".",
          "type": "string"
        }
      },
      "required": [
        "code",
        "label",
        "detail"
      ]
    }
  }
}
