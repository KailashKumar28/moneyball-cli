\n.subhead span{font-family:var(--mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--soft);white-space:nowrap}\n.subhead::before{content:\"\";width:18px;border-top:2px solid var(--ink)}\n.subhead::after{content:\"\";flex:1;border-top:1px solid var(--rule)}\n/* targeting: open ledger on paper */\n.tgwrap{overflow-x:auto;margin:0 0 14px}\n.tgtable{width:100%;border-collapse:collapse;font-size:12.5px}\n.tgtable th,.tgtable td{padding:8px 12px;text-align:right;border-bottom:1px solid var(--hair);font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}\n.tgtable th{font-size:9px;text-transform:uppercase;letter-spacing:.11em;color:var(--faint);font-weight:600;border-top:2px solid var(--ink);border-bottom:1px solid var(--rule);background:transparent}\n.tgtable th:first-child,.tgtable td:first-child{text-align:left;padding-left:0}\n.tgtable th:last-child,.tgtable td:last-child{padding-right:0}\n.tgtable tbody tr:last-child td{border-bottom:1px solid var(--rule)}\n.tgtable td.tg-nm{font-family:var(--sans);font-weight:600;max-width:300px;white-space:normal}\n.tgtable td.tg-vd{text-align:right}\n.tgtable .dim{color:var(--faint)}\n.tg-arch{font-family:var(--mono);font-size:9px;color:var(--faint);text-transform:uppercase;letter-spacing:.06em;margin-left:6px;font-weight:400}\n.tg-facts{display:flex;gap:5px;flex-wrap:wrap;margin-top:4px}\n.fact{font-family:var(--mono);font-size:9.5px;letter-spacing:.02em;color:var(--soft);border:1px solid var(--hair);border-radius:999px;padding:1px 7px;background:var(--card);font-weight:400}\n.vchip{display:inline-block;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:3px 10px;border:1px solid var(--rule);color:var(--soft);background:var(--paper)}\n.vchip.scale{color:var(--crm);border-color:#bfe0cd;background:#eef6ee}\n.vchip.kill,.vchip.zero_crm{color:var(--warn);border-color:#e6c3b4;background:#fbf0ea}\n.vchip.learning