margin-right:5px;vertical-align:baseline}\n.kdot.m{background:var(--meta)}.kdot.c{background:var(--crm)}\n.legend{font-size:11.5px;color:var(--soft);margin:2px 0 0;max-width:90ch}\n.recon{font-family:var(--mono);font-size:11.5px;color:var(--soft);margin:10px 0 0;max-width:100ch}\n.note{font-size:12px;color:var(--soft);margin:8px 0 0}\n.warnbox{background:#fbf3e8;border:1px solid #ecd9bf;border-left:4px solid var(--warn);border-radius:8px;padding:8px 12px;font-size:12px;color:#5d4326;margin:10px 0}\n/* missing-leads banner: the report's ONLY red element */\n.missing{border:1px solid #e6c3b4;border-left:4px solid var(--warn);background:#fbf0ea;border-radius:12px;padding:14px 18px;margin:18px 0 0;box-shadow:var(--sh-sm)}\n.missing b{color:var(--warn);font-size:15px}\n.missing p{margin:6px 0 0;font-size:12.5px;color:#5d3a26;line-height:1.55}\n.missing .mwhere{font-family:var(--mono);font-size:11px;color:var(--soft);margin-top:6px}\n/* exec brief */\n.insight{border:1px solid #d8c191;border-left:3px solid var(--brass);background:linear-gradient(135deg,#fbf7ec 0%,#f4ebd6 100%);border-radius:13px;padding:14px 18px;margin:4px 0 18px;box-shadow:var(--sh-sm)}\n.ins-h{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:600}\n.insight ul{margin:0;padding-left:0;list-style:none}\n.insight li{font-size:13px;line-height:1.6;color:var(--ink);margin-bottom:7px;padding-left:20px;position:relative}\n.insight li::before{content:\"\";position:absolute;left:0;top:8px;width:7px;height:7px;border-radius:50%;background:var(--brass);opacity:.55}\n.insight li:last-child{margin-bottom:0}\n.ins-good{color:var(--crm);font-weight:700}.ins-bad{color:var(--warn);font-weight:700}\n.insight.exec{margin:0}.insight.exec li{font-size:13.5px}\n#brief section{margin-top:22px}\n.insight li.win::before{background:var(--crm);opacity:.8}\n.insight li.con::before{background:var(--warn);opacity:.8}\n.tagw,.tagc,.tagi{font-family: